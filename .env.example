# OpenAI API Key for LLM guidance
OPENAI_API_KEY=your_openai_api_key_here

# Target website to crawl
TARGET_URL=https://example.com

# Maximum crawl depth
MAX_DEPTH=3

# Screenshot directory
SCREENSHOT_DIR=./screenshots

# Output JSON file
OUTPUT_FILE=./ux-report.json

# Crawl delay in ms (to avoid overloading the server)
CRAWL_DELAY=500

# Browser viewport settings
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Mobile viewport for responsive testing
MOBILE_VIEWPORT_WIDTH=375
MOBILE_VIEWPORT_HEIGHT=667
